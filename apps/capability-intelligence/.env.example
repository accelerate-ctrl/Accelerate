# Copy to .env and fill values per batch. Batch 0 needs nothing.

# ───── Service identity ─────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
APP_NAME=capability-intelligence

# ───── HTTP ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ───── Auth ─────────────────────────────────────────────────────────────────
# dev | firebase
AUTH_MODE=dev
AUTH_ALLOWED_DOMAIN=zennify.com
FIREBASE_PROJECT_ID=

# ───── GCP (Batch 1+) ───────────────────────────────────────────────────────
USE_GCP=false
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Emulator endpoints (used by docker-compose; leave blank in cloud)
FIRESTORE_EMULATOR_HOST=
PUBSUB_EMULATOR_HOST=
STORAGE_EMULATOR_HOST=

# ───── Storage buckets (Batch 1+) ───────────────────────────────────────────
BUCKET_SOWS_RAW=
BUCKET_SOWS_REDACTED=
BUCKET_SNAPSHOTS=
BUCKET_REPORTS=
BUCKET_JIRA_RAW=
BUCKET_NEWS_RAW=

# ───── Drive (Batch 1) ──────────────────────────────────────────────────────
# Pillar files are auto-discovered (recursive, latest version per pillar).
DRIVE_PILLARS_FOLDER_ID=
DRIVE_SOWS_FOLDER_ID=

# ───── Jira (Batch 3) ───────────────────────────────────────────────────────
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=[]

# ───── LLM (Batch 4) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
VERTEX_REGION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# ───── Cost guardrails (Batch 4) ────────────────────────────────────────────
DAILY_SPEND_CEILING_USD=0
ANTHROPIC_WEEKLY_BUDGET_USD=0
