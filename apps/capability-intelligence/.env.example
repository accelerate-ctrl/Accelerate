# Copy to .env and fill values.
#
# In Cloud Run, set env vars via infra/service.yaml. Secrets (Anthropic key,
# OAuth client secret, Jira token) MUST come from Secret Manager — never
# bake them into the image.

# ───── Service identity ─────────────────────────────────────────────────────
ENV=prod                       # dev | staging | prod
LOG_LEVEL=INFO
APP_NAME=capability-intelligence

# ───── HTTP ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# Cloud Run injects PORT (defaults to 8080). Don't hardcode in production.
PORT=8080
# Replace <hash> after the first deploy; add your custom domain too.
CORS_ORIGINS=["https://capability-intelligence-api-<hash>-uc.a.run.app","https://capability.zennify.com","http://localhost:5173"]

# ───── Auth ─────────────────────────────────────────────────────────────────
# dev          = bearer "dev-<email>@<domain>" (local only)
# firebase     = Firebase Admin SDK verifies the ID token
# google_oauth = Google JWKS verifies an ID token whose `aud` == GOOGLE_OAUTH_CLIENT_ID
AUTH_MODE=google_oauth
AUTH_ALLOWED_DOMAIN=zennify.com
FIREBASE_PROJECT_ID=digital-maturity-assessor

# OAuth — credentials supplied at deploy time (web client).
GOOGLE_OAUTH_CLIENT_ID=306195530103-ub6t46i8sd9q1eatpt6dgo0i9811mnrp.apps.googleusercontent.com
# Secret — mounted from Secret Manager in Cloud Run.
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URIS=["https://oauth.n8n.cloud/oauth2/callback"]

# ───── GCP ──────────────────────────────────────────────────────────────────
USE_GCP=true
GCP_PROJECT_ID=digital-maturity-assessor
GCP_PROJECT_NUMBER=306195530103
GCP_REGION=us-central1
# Leave blank inside Cloud Run — it uses the runtime SA via metadata server.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Run auto-injects K_SERVICE and K_REVISION; surface them for logs.
CLOUD_RUN_SERVICE=
CLOUD_RUN_REVISION=

# Local-emulator endpoints — leave blank in cloud.
FIRESTORE_EMULATOR_HOST=
PUBSUB_EMULATOR_HOST=
STORAGE_EMULATOR_HOST=

# ───── Firestore ────────────────────────────────────────────────────────────
FIRESTORE_DATABASE_ID=dma-assessor

# Local dev persistence (used when USE_GCP=false)
LOCAL_REPOSITORY_PATH=.local-repo.json

# ───── Storage buckets — created by infra/setup.sh ──────────────────────────
BUCKET_SOWS_RAW=digital-maturity-assessor-sows-raw
BUCKET_SOWS_REDACTED=digital-maturity-assessor-sows-redacted
BUCKET_SNAPSHOTS=digital-maturity-assessor-snapshots
BUCKET_REPORTS=digital-maturity-assessor-reports
BUCKET_JIRA_RAW=digital-maturity-assessor-jira-raw
BUCKET_NEWS_RAW=digital-maturity-assessor-news-raw

# ───── BigQuery datasets ────────────────────────────────────────────────────
BQ_DATASET_CAPABILITY_CATALOGUE=capability_catalogue
BQ_DATASET_CONTINUOUS_VALIDATION=continuous_validation
BQ_DATASET_BENCHMARKS=benchmarks
BQ_DATASET_LIFECYCLE=lifecycle
BQ_DATASET_VENDOR_INTEL=vendor_intel
BQ_DATASET_EVALS=evals
BQ_DATASET_EVIDENCE_INDEX=evidence_index
BQ_DATASET_REASONING_CHAINS=reasoning_chains
BQ_DATASET_COST_TRACKING=cost_tracking

# ───── Drive (catalogue + SOW ingest) ───────────────────────────────────────
DRIVE_PILLARS_FOLDER_ID=
DRIVE_SOWS_FOLDER_ID=

# ───── Jira ─────────────────────────────────────────────────────────────────
JIRA_BASE_URL=
JIRA_EMAIL=
# Secret — mount from Secret Manager.
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=[]

# ───── LLM ──────────────────────────────────────────────────────────────────
# Secret — mount from Secret Manager.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
VERTEX_REGION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-005
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
# Flip to true once Anthropic + Vertex creds are populated.
LLM_LIVE_MODE=true

# ───── Cost guardrails ──────────────────────────────────────────────────────
DAILY_SPEND_CEILING_USD=50
ANTHROPIC_WEEKLY_BUDGET_USD=200
COST_THROTTLE_PCT=0.9

# ───── External feeds ───────────────────────────────────────────────────────
SEC_EDGAR_EMAIL=ops@zennify.com
BUILTWITH_API_KEY=
WAPPALYZER_API_KEY=
NEWS_FEEDS=[]
