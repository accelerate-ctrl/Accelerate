# OPTIONAL containerized runner for an operator-controlled VM. The subscription
# credential comes in at runtime — never bake it into the image:
#   docker run -e W2_SERVER=https://... -e W2APP_TOKEN=... \
#     -e CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-... w2-runner
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code
WORKDIR /opt/w2app
COPY runner/ runner/
CMD ["python3", "runner/w2_runner.py", "--engine", "claude-code"]
